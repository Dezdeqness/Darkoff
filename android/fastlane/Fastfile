default_platform(:android)

require "dotenv"
Dotenv.load(File.expand_path(".env.secret", __dir__))

PROJECT_ROOT = File.expand_path("../..", __dir__)
APK_PATH = File.join(PROJECT_ROOT, "build", "app", "outputs", "flutter-apk", "app-release.apk")

platform :android do
  desc "Build release APK and upload to Firebase App Distribution"
  lane :distribute do |options|
    build_number = Time.now.to_i / 60

    sh("cd #{PROJECT_ROOT.shellescape} && fvm flutter build apk --release --build-number=#{build_number}")

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      service_credentials_file: ENV.fetch("FIREBASE_SERVICE_CREDENTIALS_FILE"),
      groups: ENV["FIREBASE_TESTER_GROUPS"],
      android_artifact_type: "APK",
      android_artifact_path: APK_PATH,
      release_notes: options[:notes] || ENV["RELEASE_NOTES"] || "Latest build",
    )
  end
end
