# --- iOS: App Store Connect API Key + signing ---
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API.
# Download the .p8 once, drop it into fastlane/ and point ASC_KEY_FILEPATH at it.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_FILEPATH=fastlane/AuthKey_XXXXXXXXXX.p8
APPLE_TEAM_ID=XXXXXXXXXX

# --- Android: Firebase App Distribution ---
# Service account JSON with the Firebase App Distribution Admin role.
FIREBASE_SERVICE_CREDENTIALS_FILE=fastlane/firebase-service-account.json
